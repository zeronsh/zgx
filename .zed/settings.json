// Zed project settings: Luau scripts get zgx's types (completion, hover and
// errors as `zgx check` reports them). Needs the Luau extension
// (4teapo/zed-luau). See docs/scripting.md#types.
{
  "lsp": {
    "luau-lsp": {
      "settings": {
        "roblox": { "enabled": false },
        // zgx's types need Luau's new type solver; Roblox's flags do not apply.
        // and `zgx check`'s iteration budget (a `Merge` of an element's
        // props handed back to it needs more than the default's).
        "fflags": {
          "enable_new_solver": true,
          "sync": false,
          "override": { "LuauTypeInferIterationLimit": "100000" }
        },
        "definitions": ["crates/zgx-script/types/zgx.d.luau"],
        "luau-lsp": {
          "platform": { "type": "standard" },
          "sourcemap": { "enabled": false }
        }
      }
    }
  }
}
